# ================================
# Environment Variables - Development
# ================================
# Copy this file to .env and fill in the values
# Usage: docker compose up

# Database (PostgreSQL for dev - same as prod for consistency)
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi_dev_password

# Strapi Security (dev values - NOT for production)
APP_KEYS="devKey1,devKey2,devKey3,devKey4"
API_TOKEN_SALT=devApiTokenSalt
ADMIN_JWT_SECRET=devAdminJwtSecret
TRANSFER_TOKEN_SALT=devTransferTokenSalt
JWT_SECRET=devJwtSecret
ENCRYPTION_KEY=devEncryptionKey12345678901234

# Strapi URL (for frontend to fetch content)
STRAPI_URL=http://localhost:1337
