# ================================
# Environment Variables - Production
# ================================
# Copy this file to .env.production on the VPS
# Generate secrets with: ./scripts/generate-secrets.sh

# ================================
# Database (PostgreSQL)
# ================================
DATABASE_NAME=ligue_alternants
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# ================================
# Strapi Security Keys
# ================================
# IMPORTANT: Generate these with ./scripts/generate-secrets.sh
# NEVER commit real values to git!

APP_KEYS="GENERATE_ME,GENERATE_ME,GENERATE_ME,GENERATE_ME"
API_TOKEN_SALT=GENERATE_ME
ADMIN_JWT_SECRET=GENERATE_ME
TRANSFER_TOKEN_SALT=GENERATE_ME
JWT_SECRET=GENERATE_ME
ENCRYPTION_KEY=GENERATE_ME

# ================================
# URLs
# ================================
# Strapi URL (used by frontend during build)
STRAPI_URL=https://liguedesalternants.fr

# ================================
# SSL (optional)
# ================================
# Email for Let's Encrypt certificate notifications
SSL_EMAIL=admin@liguedesalternants.fr
